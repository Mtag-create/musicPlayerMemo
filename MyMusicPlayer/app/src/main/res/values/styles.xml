<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        起動直後、Compose側がUIを描画し終えるまでの間にOSがまず表示するウィンドウ背景。
        デフォルトのTheme.Material.Light系だと背景が白になり、
        アプリ本来のダーク背景(Theme.ktのbackground: 0xFF0A0A0F)に切り替わるまでの
        一瞬だけ白フラッシュが見えてしまうため、起動時点から同じ色にしておく。

        minSdk=35(Android 12以降)のため、OS標準のSplashScreen機構が必ず介在する。
        この機構はandroid:windowBackgroundではなく、
        android:windowSplashScreenBackground(API31+)を見て起動画面の背景色を決めるため、
        両方設定しておく必要がある。
    -->
    <style name="Theme.MyMusicPlayer" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/launch_background</item>
        <item name="android:colorBackground">@color/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/launch_background</item>
    </style>
</resources>